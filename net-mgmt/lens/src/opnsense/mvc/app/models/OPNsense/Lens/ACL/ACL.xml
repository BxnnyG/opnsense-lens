<acl>
    <page-services-lens>
        <name>Services: Lens</name>
        <patterns>
            <pattern>ui/lens/preflight*</pattern>
            <pattern>api/lens/sources/*</pattern>
            <pattern>api/lens/store/*</pattern>
            <!--
                Settings write retention, the probe targets and purge (§4.58).
                They are here and deliberately not under Reporting: Lens: a
                user who may read the reports may not shorten their history.
            -->
            <pattern>ui/lens/settings*</pattern>
            <pattern>api/lens/settings/*</pattern>
            <!-- forgetting a device deletes, as purge does (§4.72) -->
            <pattern>ui/lens/privacy*</pattern>
            <pattern>api/lens/privacy/*</pattern>
        </patterns>
    </page-services-lens>
    <page-reporting-lens>
        <name>Reporting: Lens</name>
        <patterns>
            <pattern>ui/lens/overview*</pattern>
            <pattern>ui/lens/wall*</pattern>
            <pattern>ui/lens/segments*</pattern>
            <pattern>ui/lens/dashboard*</pattern>
            <pattern>ui/lens/presence*</pattern>
            <pattern>ui/lens/device*</pattern>
            <pattern>ui/lens/events*</pattern>
            <pattern>ui/lens/report*</pattern>
            <pattern>api/lens/dashboard/*</pattern>
            <pattern>api/lens/events/*</pattern>
            <pattern>api/lens/metrics/*</pattern>
            <pattern>api/lens/segments/*</pattern>
            <pattern>api/lens/sources/*</pattern>
            <pattern>api/lens/store/*</pattern>
            <!--
                Added 2026-09-12, five stages late. The device list, the detail
                view, the dashboard widget and the label editor were all reachable
                only because the operator is root: no pattern here matched them, so
                a user holding exactly this privilege got an empty page and no
                explanation. tests/gates/lint_acl.py now fails the build instead.

                The label editor writes, and it belongs here rather than under
                Services because it writes Lens's own notes about a device, not
                the firewall's configuration. The §4.5 boundary is about the
                latter, and §4.35's fix button is still the only thing that
                crosses it.
            -->
            <pattern>api/lens/devices/*</pattern>
        </patterns>
    </page-reporting-lens>
    <!--
        What devices looked up (§4.64). Its own privilege, because core keeps
        the same questions behind Status: DNS Overview: a user who may read
        Lens but not that must not read DNS through Lens.
    -->
    <page-reporting-lens-dns>
        <name>Reporting: Lens: DNS</name>
        <patterns>
            <pattern>ui/lens/dns*</pattern>
            <pattern>api/lens/dns/*</pattern>
        </patterns>
    </page-reporting-lens-dns>
</acl>
