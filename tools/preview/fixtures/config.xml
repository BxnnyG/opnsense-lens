<?xml version="1.0"?>
<!-- Shaped like the operator's box (ROADMAP, operations notes): PPPoE, five VLANs on vtnet1, NetBird. -->
<opnsense>
  <interfaces>
    <wan><if>pppoe0</if><descr>WAN</descr><enable>1</enable></wan>
    <lan><if>vtnet1</if><descr>LAN</descr><enable>1</enable></lan>
    <opt1><if>vtnet1_vlan10</if><descr>MGNT</descr><enable>1</enable></opt1>
    <opt2><if>vtnet1_vlan20</if><descr>HOME</descr><enable>1</enable></opt2>
    <opt3><if>vtnet1_vlan21</if><descr>IOT</descr><enable>1</enable></opt3>
    <opt4><if>vtnet1_vlan22</if><descr>GUEST</descr><enable>1</enable></opt4>
    <opt5><if>vtnet1_vlan30</if><descr>SERVER</descr><enable>1</enable></opt5>
    <opt6><if>wt0</if><descr>NetBird</descr><enable>1</enable></opt6>
  </interfaces>
  <OPNsense>
    <Netflow>
      <capture><interfaces>wan,lan,opt1,opt2,opt3,opt4,opt5</interfaces><egress_only>wan</egress_only></capture>
      <collect><enable>1</enable></collect>
    </Netflow>
    <unboundplus><general><stats>0</stats></general></unboundplus>
    <!-- stage 59: one road-warrior server; names only, the preview carries no key -->
    <OpenVPN><Instances>
      <Instance uuid="0e0e0e0e-0000-4000-8000-000000000059"><vpnid>1</vpnid><enabled>1</enabled><role>server</role><description>Road warriors</description></Instance>
    </Instances></OpenVPN>
  </OPNsense>
  <!-- stage 59: HOME and SERVER shared with a second firewall, this one master -->
  <virtualip>
    <vip uuid="0f0f0f0f-0000-4000-8000-000000000001"><mode>carp</mode><vhid>20</vhid><subnet>10.10.20.254</subnet><interface>opt2</interface></vip>
    <vip uuid="0f0f0f0f-0000-4000-8000-000000000002"><mode>carp</mode><vhid>30</vhid><subnet>10.10.30.254</subnet><interface>opt5</interface></vip>
  </virtualip>
  <!-- stage 50: the web GUI's certificate, in use; public part only, no key -->
  <system>
    <webgui>
      <ssl-certref>5f1a2b3c4d5e6</ssl-certref>
    </webgui>
  </system>
  <cert uuid="b0b0b0b0-0000-4000-8000-000000000050">
    <refid>5f1a2b3c4d5e6</refid>
    <descr>Web GUI</descr>
    <crt></crt>
  </cert>
</opnsense>
